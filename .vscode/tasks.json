{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arc PDF: Check",
      "type": "shell",
      "command": "scripts/check.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Arc PDF: Build App",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "arc-pdf-app", "--bin", "arc-pdf-app"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ARCPDF_PDFIUM_TARGET": "macos_arm64"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Arc PDFium: Build macos_arm64",
      "type": "shell",
      "command": "scripts/build-pdfium",
      "args": ["--target", "macos_arm64"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Arc PDFium: Update + Build macos_arm64",
      "type": "shell",
      "command": "scripts/build-pdfium",
      "args": ["--update", "--target", "macos_arm64"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
